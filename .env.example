# Copy to `.env` (or `.env.local`) and fill in from your Supabase project:
# Dashboard -> Project Settings -> API.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The public "anon"/publishable key. Safe to ship to browsers; Row Level Security protects the data.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# The project ref (the subdomain of VITE_SUPABASE_URL). Used to build the MCP OAuth issuer URL.
VITE_SUPABASE_PROJECT_ID=your-project-ref

# NOT a VITE_ variable: TMDB_API_KEY is a server-side secret used by the `tmdb` and `mcp` edge
# functions. Never put it in this file or in client code. Set it with:
#   supabase secrets set TMDB_API_KEY=your-tmdb-api-key

# Optional: the public origin of the deployed site, used for canonical URLs, share cards, the
# sitemap and robots.txt. Defaults to https://reel.omsingh.me; set it if you deploy under another domain.
# VITE_SITE_URL=https://your-domain.example
